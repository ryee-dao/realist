# Content-Security-Policy of the built site (web/index.html). Everything is served from our own origin except
# the OpenStreetMap tiles (fonts are self-hosted). 'wasm-unsafe-eval' lets DuckDB-WASM compile; its worker starts from a
# blob: URL so it inherits this policy: SQL can reach only this site and DuckDB's (signed) extension repository, which
# serves the parquet reader. Inline style attributes are needed by React and Leaflet.
VITE_CSP="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' https://extensions.duckdb.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
